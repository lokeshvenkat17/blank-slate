{
  "name": "Haskell",
  "scopeName": "source.haskell",
  "fileTypes": [
    "hs",
    "lhs"
  ],
  "patterns": [
    {
      "include": "#line-comment"
    },
    {
      "include": "#block-comment"
    },
    {
      "include": "#double-string"
    },
    {
      "include": "#single-string"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "line-comment": {
      "match": "(?:\\-\\-).*$",
      "name": "comment.line.haskell"
    },
    "block-comment": {
      "begin": "\\{\\-",
      "end": "\\-\\}",
      "name": "comment.block.haskell"
    },
    "double-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.haskell",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.haskell"
        }
      ]
    },
    "single-string": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.haskell",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.haskell"
        }
      ]
    },
    "constants": {
      "match": "(?<![\\w.])True|False|Nothing|Just|Left|Right|otherwise(?![\\w])",
      "name": "constant.language.haskell"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.haskell"
    },
    "keywords": {
      "match": "\\b(?:qualified|instance|deriving|newtype|module|import|hiding|infixl|infixr|forall|where|class|infix|case|then|else|data|type|let|in|of|if|do|as)\\b",
      "name": "keyword.control.haskell"
    },
    "types": {
      "match": "\\b(?:Ordering|Integer|Double|String|Either|Float|Maybe|Char|Bool|Int|IO)\\b",
      "name": "storage.type.haskell"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.haskell"
        }
      }
    }
  }
}