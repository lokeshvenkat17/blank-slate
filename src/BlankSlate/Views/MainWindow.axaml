<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlankSlate.ViewModels"
        xmlns:views="using:BlankSlate.Views"
        xmlns:models="using:BlankSlate.Models"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="BlankSlate.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000" Height="650"
        DragDrop.AllowDrop="True"
        Icon="/Assets/BlankSlateIcon.png"
        Title="{Binding WindowTitle}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="New" Gesture="{OnPlatform Ctrl+N, macOS=Cmd+N}" Command="{Binding NewFileCommand}" />
            <NativeMenuItem Header="Open…" Gesture="{OnPlatform Ctrl+O, macOS=Cmd+O}" Command="{Binding OpenFileCommand}" />
            <NativeMenuItem Header="Open Recent">
              <NativeMenuItem.Menu><NativeMenu /></NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Save" Gesture="{OnPlatform Ctrl+S, macOS=Cmd+S}" Command="{Binding SaveCommand}" />
            <NativeMenuItem Header="Save As…" Gesture="{OnPlatform Ctrl+Shift+S, macOS=Cmd+Shift+S}" Command="{Binding SaveAsCommand}" />
            <NativeMenuItem Header="Save All" Command="{Binding SaveAllCommand}" />
            <NativeMenuItem Header="Rename…" Command="{Binding RenameCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Close Tab" Gesture="{OnPlatform Ctrl+W, macOS=Cmd+W}" Command="{Binding CloseDocumentCommand}" />
            <NativeMenuItem Header="Close All" Command="{Binding CloseAllCommand}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Undo" Gesture="{OnPlatform Ctrl+Z, macOS=Cmd+Z}" Command="{Binding UndoCommand}" />
            <NativeMenuItem Header="Redo" Gesture="{OnPlatform Ctrl+Y, macOS=Cmd+Shift+Z}" Command="{Binding RedoCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Cut" Gesture="{OnPlatform Ctrl+X, macOS=Cmd+X}" Command="{Binding CutCommand}" />
            <NativeMenuItem Header="Copy" Gesture="{OnPlatform Ctrl+C, macOS=Cmd+C}" Command="{Binding CopyCommand}" />
            <NativeMenuItem Header="Paste" Gesture="{OnPlatform Ctrl+V, macOS=Cmd+V}" Command="{Binding PasteCommand}" />
            <NativeMenuItem Header="Delete" Gesture="Delete" Command="{Binding DeleteCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Select All" Gesture="{OnPlatform Ctrl+A, macOS=Cmd+A}" Command="{Binding SelectAllCommand}" />
            <NativeMenuItem Header="Auto-Completion">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Word Completion" Gesture="{OnPlatform Ctrl+Space, macOS=Ctrl+Space}" Command="{Binding WordCompletionCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Begin/End Select" Gesture="{OnPlatform Ctrl+Alt+M, macOS=Cmd+Alt+M}" Command="{Binding BeginEndSelectCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Insert">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Date Time (short)" Command="{Binding InsertDateTimeShortCommand}" />
                  <NativeMenuItem Header="Date Time (long)" Command="{Binding InsertDateTimeLongCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Copy to Clipboard">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Copy Current Full File Path" Command="{Binding CopyToClipboardCommand}" CommandParameter="path" />
                  <NativeMenuItem Header="Copy Current Filename" Command="{Binding CopyToClipboardCommand}" CommandParameter="name" />
                  <NativeMenuItem Header="Copy Current Dir. Path" Command="{Binding CopyToClipboardCommand}" CommandParameter="dir" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="Copy All Filenames" Command="{Binding CopyToClipboardCommand}" CommandParameter="allnames" />
                  <NativeMenuItem Header="Copy All File Paths" Command="{Binding CopyToClipboardCommand}" CommandParameter="allpaths" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Indent">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Increase Line Indent" Command="{Binding IncreaseIndentCommand}" />
                  <NativeMenuItem Header="Decrease Line Indent" Command="{Binding DecreaseIndentCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Convert Case to">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="UPPERCASE" Gesture="{OnPlatform Ctrl+Shift+U, macOS=Cmd+Shift+U}" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.Upper}" />
                  <NativeMenuItem Header="lowercase" Gesture="{OnPlatform Ctrl+U, macOS=Cmd+U}" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.Lower}" />
                  <NativeMenuItem Header="Proper Case" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.ProperForce}" />
                  <NativeMenuItem Header="Proper Case (blend)" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.ProperBlend}" />
                  <NativeMenuItem Header="Sentence case" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.SentenceForce}" />
                  <NativeMenuItem Header="Sentence case (blend)" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.SentenceBlend}" />
                  <NativeMenuItem Header="iNVERT cASE" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.Invert}" />
                  <NativeMenuItem Header="ranDOm CasE" Command="{Binding ConvertCaseCommand}" CommandParameter="{x:Static models:CaseKind.Random}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Line Operations">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Duplicate Current Line" Gesture="{OnPlatform Ctrl+D, macOS=Cmd+D}" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.Duplicate}" />
                  <NativeMenuItem Header="Remove Duplicate Lines" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.RemoveDuplicates}" />
                  <NativeMenuItem Header="Remove Consecutive Duplicate Lines" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.RemoveConsecutiveDuplicates}" />
                  <NativeMenuItem Header="Join Lines" Gesture="{OnPlatform Ctrl+J, macOS=Cmd+J}" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.JoinLines}" />
                  <NativeMenuItem Header="Move Up Current Line" Gesture="{OnPlatform Ctrl+Shift+Up, macOS=Cmd+Shift+Up}" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.MoveUp}" />
                  <NativeMenuItem Header="Move Down Current Line" Gesture="{OnPlatform Ctrl+Shift+Down, macOS=Cmd+Shift+Down}" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.MoveDown}" />
                  <NativeMenuItem Header="Remove Empty Lines" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.RemoveEmpty}" />
                  <NativeMenuItem Header="Remove Empty Lines (Containing Blank characters)" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.RemoveEmptyWithBlank}" />
                  <NativeMenuItem Header="Insert Blank Line Above Current" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.BlankAbove}" />
                  <NativeMenuItem Header="Insert Blank Line Below Current" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.BlankBelow}" />
                  <NativeMenuItem Header="Reverse Line Order" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.Reverse}" />
                  <NativeMenuItem Header="Randomize Line Order" Command="{Binding LineOperationCommand}" CommandParameter="{x:Static models:LineOpKind.Randomize}" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="Sort Lines Lexicographically Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LexAsc}" />
                  <NativeMenuItem Header="Sort Lines Lex. Ascending Ignoring Case" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LexCiAsc}" />
                  <NativeMenuItem Header="Sort Lines In Locale Order Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LocaleAsc}" />
                  <NativeMenuItem Header="Sort Lines As Integers Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.IntAsc}" />
                  <NativeMenuItem Header="Sort Lines As Decimals (Comma) Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.DecCommaAsc}" />
                  <NativeMenuItem Header="Sort Lines As Decimals (Dot) Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.DecDotAsc}" />
                  <NativeMenuItem Header="Sort Lines By Length Ascending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LenAsc}" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="Sort Lines Lexicographically Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LexDesc}" />
                  <NativeMenuItem Header="Sort Lines Lex. Descending Ignoring Case" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LexCiDesc}" />
                  <NativeMenuItem Header="Sort Lines In Locale Order Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LocaleDesc}" />
                  <NativeMenuItem Header="Sort Lines As Integers Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.IntDesc}" />
                  <NativeMenuItem Header="Sort Lines As Decimals (Comma) Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.DecCommaDesc}" />
                  <NativeMenuItem Header="Sort Lines As Decimals (Dot) Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.DecDotDesc}" />
                  <NativeMenuItem Header="Sort Lines By Length Descending" Command="{Binding SortLinesCommand}" CommandParameter="{x:Static models:SortKind.LenDesc}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Comment/Uncomment">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Toggle Single Line Comment" Gesture="{OnPlatform Ctrl+Q, macOS=Cmd+OemQuestion}" Command="{Binding CommentOperationCommand}" CommandParameter="{x:Static models:CommentOpKind.ToggleLine}" />
                  <NativeMenuItem Header="Single Line Comment" Command="{Binding CommentOperationCommand}" CommandParameter="{x:Static models:CommentOpKind.SetLine}" />
                  <NativeMenuItem Header="Single Line Uncomment" Command="{Binding CommentOperationCommand}" CommandParameter="{x:Static models:CommentOpKind.RemoveLine}" />
                  <NativeMenuItem Header="Block Comment" Command="{Binding CommentOperationCommand}" CommandParameter="{x:Static models:CommentOpKind.BlockSet}" />
                  <NativeMenuItem Header="Block Uncomment" Command="{Binding CommentOperationCommand}" CommandParameter="{x:Static models:CommentOpKind.BlockRemove}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Blank Operations">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Trim Trailing Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.TrimTrailing}" />
                  <NativeMenuItem Header="Trim Leading Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.TrimLeading}" />
                  <NativeMenuItem Header="Trim Leading and Trailing Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.TrimBoth}" />
                  <NativeMenuItem Header="EOL to Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.EolToSpace}" />
                  <NativeMenuItem Header="Trim Both and EOL to Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.TrimAll}" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="TAB to Space" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.TabToSpace}" />
                  <NativeMenuItem Header="Space to TAB (All)" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.SpaceToTabAll}" />
                  <NativeMenuItem Header="Space to TAB (Leading)" Command="{Binding BlankOperationCommand}" CommandParameter="{x:Static models:BlankOpKind.SpaceToTabLeading}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="EOL Conversion">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Windows (CR LF)" Command="{Binding SetEolCommand}" CommandParameter="{x:Static models:EolMode.Crlf}" />
                  <NativeMenuItem Header="Unix (LF)" Command="{Binding SetEolCommand}" CommandParameter="{x:Static models:EolMode.Lf}" />
                  <NativeMenuItem Header="Macintosh (CR)" Command="{Binding SetEolCommand}" CommandParameter="{x:Static models:EolMode.Cr}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Search">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Find…" Gesture="{OnPlatform Ctrl+F, macOS=Cmd+F}" Command="{Binding ShowFindCommand}" />
            <NativeMenuItem Header="Find in Files…" Gesture="{OnPlatform Ctrl+Shift+F, macOS=Cmd+Shift+F}" Command="{Binding ShowFindInFilesCommand}" />
            <NativeMenuItem Header="Find Next" Gesture="F3" Command="{Binding FindNextCommand}" />
            <NativeMenuItem Header="Find Previous" Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
            <NativeMenuItem Header="Select and Find Next" Gesture="{OnPlatform Ctrl+F3, macOS=Cmd+F3}" Command="{Binding SelectAndFindNextCommand}" />
            <NativeMenuItem Header="Select and Find Previous" Gesture="{OnPlatform Ctrl+Shift+F3, macOS=Cmd+Shift+F3}" Command="{Binding SelectAndFindPreviousCommand}" />
            <NativeMenuItem Header="Replace…" Gesture="{OnPlatform Ctrl+H, macOS=Cmd+Alt+F}" Command="{Binding ShowReplaceCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Go to…" Gesture="{OnPlatform Ctrl+G, macOS=Cmd+L}" Command="{Binding GoToLineCommand}" />
            <NativeMenuItem Header="Mark…" Command="{Binding ShowMarkCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Style All Occurrences of Token">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Using 1st Style" Command="{Binding StyleAllOccurrencesCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 2nd Style" Command="{Binding StyleAllOccurrencesCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 3rd Style" Command="{Binding StyleAllOccurrencesCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 4th Style" Command="{Binding StyleAllOccurrencesCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 5th Style" Command="{Binding StyleAllOccurrencesCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Style One Token">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Using 1st Style" Command="{Binding StyleOneTokenCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 2nd Style" Command="{Binding StyleOneTokenCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 3rd Style" Command="{Binding StyleOneTokenCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 4th Style" Command="{Binding StyleOneTokenCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Using 5th Style" Command="{Binding StyleOneTokenCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Clear Style">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Clear 1st Style" Command="{Binding ClearStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Clear 2nd Style" Command="{Binding ClearStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Clear 3rd Style" Command="{Binding ClearStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Clear 4th Style" Command="{Binding ClearStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="Clear 5th Style" Command="{Binding ClearStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="Clear All Styles" Command="{Binding ClearAllStylesCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Jump Up">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="1st Style" Command="{Binding JumpUpStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="2nd Style" Command="{Binding JumpUpStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="3rd Style" Command="{Binding JumpUpStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="4th Style" Command="{Binding JumpUpStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="5th Style" Command="{Binding JumpUpStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Jump Down">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="1st Style" Command="{Binding JumpDownStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="2nd Style" Command="{Binding JumpDownStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="3rd Style" Command="{Binding JumpDownStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="4th Style" Command="{Binding JumpDownStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="5th Style" Command="{Binding JumpDownStyleCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Copy Styled Text">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="1st Style" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>0</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="2nd Style" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="3rd Style" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>2</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="4th Style" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>3</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItem Header="5th Style" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>4</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="All Styles" Command="{Binding CopyStyledTextCommand}">
                    <NativeMenuItem.CommandParameter><sys:Int32>-1</sys:Int32></NativeMenuItem.CommandParameter>
                  </NativeMenuItem>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Change History">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Go to Next Change" Command="{Binding GoToNextChangeCommand}" />
                  <NativeMenuItem Header="Go to Previous Change" Command="{Binding GoToPreviousChangeCommand}" />
                  <NativeMenuItem Header="Clear Change History" Command="{Binding ClearChangeHistoryCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Incremental Search" Gesture="{OnPlatform Ctrl+Alt+I, macOS=Cmd+Alt+I}" Command="{Binding ShowIncrementalSearchCommand}" />
            <NativeMenuItem Header="Go to Matching Brace" Gesture="{OnPlatform Ctrl+B, macOS=Cmd+B}" Command="{Binding GoToMatchingBraceCommand}" />
            <NativeMenuItem Header="Select All In-between Braces" Gesture="{OnPlatform Ctrl+Alt+B, macOS=Cmd+Alt+B}" Command="{Binding SelectBetweenBracesCommand}" />
            <NativeMenuItem Header="Bookmark">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Toggle Bookmark" Gesture="{OnPlatform Ctrl+F2, macOS=Cmd+F2}" Command="{Binding ToggleBookmarkCommand}" />
                  <NativeMenuItem Header="Next Bookmark" Gesture="F2" Command="{Binding NextBookmarkCommand}" />
                  <NativeMenuItem Header="Previous Bookmark" Gesture="Shift+F2" Command="{Binding PreviousBookmarkCommand}" />
                  <NativeMenuItem Header="Clear All Bookmarks" Command="{Binding ClearBookmarksCommand}" />
                  <NativeMenuItem Header="Inverse Bookmarks" Command="{Binding InverseBookmarksCommand}" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="Cut Bookmarked Lines" Command="{Binding CutBookmarkedLinesCommand}" />
                  <NativeMenuItem Header="Copy Bookmarked Lines" Command="{Binding CopyBookmarkedLinesCommand}" />
                  <NativeMenuItem Header="Paste to (Replace) Bookmarked Lines" Command="{Binding PasteToBookmarkedLinesCommand}" />
                  <NativeMenuItem Header="Remove Bookmarked Lines" Command="{Binding RemoveBookmarkedLinesCommand}" />
                  <NativeMenuItem Header="Remove Non-Bookmarked Lines" Command="{Binding RemoveNonBookmarkedLinesCommand}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Word Wrap" ToggleType="CheckBox" IsChecked="{Binding Settings.WordWrap}" />
            <NativeMenuItem Header="Show Whitespace and TAB" ToggleType="CheckBox" IsChecked="{Binding Settings.ShowWhitespace}" />
            <NativeMenuItem Header="Show End of Line" ToggleType="CheckBox" IsChecked="{Binding Settings.ShowEndOfLine}" />
            <NativeMenuItem Header="Highlight Current Line" ToggleType="CheckBox" IsChecked="{Binding Settings.HighlightCurrentLine}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Move Current Document to Other View" Command="{Binding MoveToOtherViewCommand}" />
            <NativeMenuItem Header="Clone Current Document to Other View" Command="{Binding CloneToOtherViewCommand}" />
            <NativeMenuItem Header="Document Map" ToggleType="CheckBox" IsChecked="{Binding IsDocumentMapVisible}" />
            <NativeMenuItem Header="Function List" ToggleType="CheckBox" IsChecked="{Binding IsFunctionListVisible}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Zoom In" Gesture="{OnPlatform Ctrl+OemPlus, macOS=Cmd+OemPlus}" Command="{Binding ZoomInCommand}" />
            <NativeMenuItem Header="Zoom Out" Gesture="{OnPlatform Ctrl+OemMinus, macOS=Cmd+OemMinus}" Command="{Binding ZoomOutCommand}" />
            <NativeMenuItem Header="Restore Default Zoom" Gesture="{OnPlatform Ctrl+D0, macOS=Cmd+D0}" Command="{Binding ZoomResetCommand}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Language">
        <NativeMenuItem.Menu><NativeMenu /></NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Macro">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Start Recording" Gesture="{OnPlatform Ctrl+Shift+R, macOS=Cmd+Shift+R}" Command="{Binding StartMacroRecordingCommand}" />
            <NativeMenuItem Header="Stop Recording" Command="{Binding StopMacroRecordingCommand}" />
            <NativeMenuItem Header="Playback" Gesture="{OnPlatform Ctrl+Shift+P, macOS=Cmd+Shift+P}" Command="{Binding PlaybackMacroCommand}" />
            <NativeMenuItem Header="Run a Macro Multiple Times…" Command="{Binding RunMacroMultipleTimesCommand}" />
            <NativeMenuItem Header="Save Current Recorded Macro…" Command="{Binding SaveCurrentMacroCommand}" />
            <NativeMenuItemSeparator />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Encoding">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="UTF-8" Command="{Binding SetEncodingCommand}" CommandParameter="{x:Static models:TextEncodingKind.Utf8}" />
            <NativeMenuItem Header="UTF-8-BOM" Command="{Binding SetEncodingCommand}" CommandParameter="{x:Static models:TextEncodingKind.Utf8Bom}" />
            <NativeMenuItem Header="UTF-16 LE BOM" Command="{Binding SetEncodingCommand}" CommandParameter="{x:Static models:TextEncodingKind.Utf16LeBom}" />
            <NativeMenuItem Header="UTF-16 BE BOM" Command="{Binding SetEncodingCommand}" CommandParameter="{x:Static models:TextEncodingKind.Utf16BeBom}" />
            <NativeMenuItem Header="ANSI" Command="{Binding SetEncodingCommand}" CommandParameter="{x:Static models:TextEncodingKind.Ansi}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Plugins">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Plugin Manager…" />
            <NativeMenuItem Header="Open Plugins Folder…" Command="{Binding OpenPluginsFolderCommand}" />
            <NativeMenuItemSeparator />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="About BlankSlate" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <!-- Compact Notepad++-style file tabs (Fluent default is oversized pivot headers) -->
  <Window.Styles>
    <Style Selector="TabStrip#DocumentTabs > TabStripItem, TabStrip#SecondaryTabs > TabStripItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabStrip#DocumentTabs > TabStripItem:selected, TabStrip#SecondaryTabs > TabStripItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ============ Menu bar ============ -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- ============ Incremental search bar ============ -->
    <Border DockPanel.Dock="Bottom" Padding="8,5" IsVisible="{Binding IsIncrementalSearchVisible}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Find:" VerticalAlignment="Center" FontSize="12" />
        <TextBox Name="IncrementalSearchBox" Width="260" FontSize="12" Padding="6,2"
                 Text="{Binding IncrementalSearchText}"
                 KeyDown="OnIncrementalSearchKeyDown" />
        <Button Content="▲" FontSize="10" Padding="7,2" Command="{Binding IncrementalSearchPreviousCommand}"
                ToolTip.Tip="Previous match (Shift+Enter)" />
        <Button Content="▼" FontSize="10" Padding="7,2" Command="{Binding IncrementalSearchNextCommand}"
                ToolTip.Tip="Next match (Enter)" />
        <TextBlock Text="{Binding IncrementalSearchStatus}" VerticalAlignment="Center"
                   FontSize="12" Foreground="#D13438" />
        <Button Content="✕" FontSize="10" Padding="7,2" Background="Transparent" BorderThickness="0"
                Command="{Binding HideIncrementalSearchCommand}" ToolTip.Tip="Close (Esc)" />
      </StackPanel>
    </Border>

    <!-- ============ Status bar ============ -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            Padding="10,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="24">
          <TextBlock FontSize="12">
            <Run Text="Ln " /><Run Text="{Binding SelectedDocument.CaretLine, FallbackValue=1}" /><Run Text=", Col " /><Run Text="{Binding SelectedDocument.CaretColumn, FallbackValue=1}" />
          </TextBlock>
          <TextBlock FontSize="12" Text="{Binding SelectedDocument.LanguageName, FallbackValue='Normal Text'}" />
          <TextBlock FontSize="12" Text="{Binding SelectedDocument.EolLabel, FallbackValue='Unix (LF)'}" />
          <TextBlock FontSize="12" Text="{Binding SelectedDocument.EncodingLabel, FallbackValue=UTF-8}" />
        </StackPanel>
        <TextBlock FontSize="12"
                   Text="{Binding SelectedDocument.FilePath, FallbackValue=''}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============ Function List panel ============ -->
    <Border DockPanel.Dock="Right" Width="220" IsVisible="{Binding IsFunctionListVisible}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="8,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <TextBlock Text="Function List" FontWeight="Bold" FontSize="12" />
        </Border>
        <ListBox Grid.Row="1" Name="FunctionListBox"
                 ItemsSource="{Binding FunctionList}"
                 DoubleTapped="OnFunctionDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="ƒ" Foreground="{DynamicResource SystemAccentColor}" FontWeight="Bold" />
                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ============ Document tabs + search results ============ -->
    <Grid RowDefinitions="*,Auto,Auto">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Name="ViewsGrid">
      <DockPanel Grid.Column="0">
        <!-- Tab row: the strip sizes to its tabs, so the + button lands right after
             the last one instead of being pushed to the window edge. -->
        <DockPanel DockPanel.Dock="Top">
          <TabStrip Name="DocumentTabs" DockPanel.Dock="Left"
                    ItemsSource="{Binding PrimaryDocuments}"
                    SelectedItem="{Binding PrimarySelectedDocument}">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                        DoubleTapped="OnTabHeaderDoubleTapped"
                        ToolTip.Tip="Double-click to rename">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <TextBlock Text="•" VerticalAlignment="Center" FontWeight="Bold"
                         IsVisible="{Binding IsDirty}" />
              <Button Content="✕" FontSize="10" Padding="4,1"
                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseDocumentCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
          <Button DockPanel.Dock="Left" Content="+" FontSize="16" Padding="8,1"
                  Margin="4,0,0,0" VerticalAlignment="Center"
                  Background="Transparent" BorderThickness="0"
                  Command="{Binding NewFileCommand}"
                  ToolTip.Tip="New tab (⌘N)" />
          <Panel />
        </DockPanel>

        <ContentControl Content="{Binding PrimarySelectedDocument}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:DocumentViewModel">
              <views:DocumentEditorHost />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsSecondaryViewVisible}" />

      <!-- Second tab group (Notepad++'s other view) -->
      <DockPanel Grid.Column="2" IsVisible="{Binding IsSecondaryViewVisible}">
        <DockPanel DockPanel.Dock="Top">
          <TabStrip Name="SecondaryTabs" DockPanel.Dock="Left"
                    ItemsSource="{Binding SecondaryDocuments}"
                    SelectedItem="{Binding SecondarySelectedDocument}">
            <TabStrip.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                        DoubleTapped="OnTabHeaderDoubleTapped"
                        ToolTip.Tip="Double-click to rename">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <TextBlock Text="•" VerticalAlignment="Center" FontWeight="Bold"
                         IsVisible="{Binding IsDirty}" />
              <Button Content="✕" FontSize="10" Padding="4,1"
                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseDocumentCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
              </DataTemplate>
            </TabStrip.ItemTemplate>
          </TabStrip>
          <Panel />
        </DockPanel>

        <ContentControl Content="{Binding SecondarySelectedDocument}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:DocumentViewModel">
              <views:DocumentEditorHost />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </DockPanel>
      </Grid>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsSearchResultsVisible}" />

      <Grid Grid.Row="2" RowDefinitions="Auto,*" Height="180"
            IsVisible="{Binding IsSearchResultsVisible}">
        <Border Grid.Row="0" Padding="8,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="4,1"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CloseSearchResultsCommand}" />
            <TextBlock Text="{Binding SearchResultsHeader}" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <ListBox Grid.Row="1" Name="ResultsList"
                 ItemsSource="{Binding SearchResults}"
                 DoubleTapped="OnResultDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchResultItem">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Location}" FontWeight="Bold" FontSize="12" />
                <TextBlock Text="{Binding LineText}" FontSize="12"
                           FontFamily="Menlo,Monaco,Consolas,monospace"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

    </Grid>

  </DockPanel>
</Window>
