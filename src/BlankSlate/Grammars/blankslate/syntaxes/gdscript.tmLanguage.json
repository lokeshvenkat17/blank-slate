{
  "name": "GDScript",
  "scopeName": "source.gdscript",
  "fileTypes": [
    "gd"
  ],
  "patterns": [
    {
      "include": "#line-comment"
    },
    {
      "include": "#double-string"
    },
    {
      "include": "#single-string"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "line-comment": {
      "match": "(?:\\#).*$",
      "name": "comment.line.gdscript"
    },
    "double-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.gdscript",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gdscript"
        }
      ]
    },
    "single-string": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.gdscript",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gdscript"
        }
      ]
    },
    "constants": {
      "match": "(?<![\\w.])true|false|null|PI|TAU|INF|NAN(?![\\w])",
      "name": "constant.language.gdscript"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.gdscript"
    },
    "keywords": {
      "match": "\\b(?:class_name|breakpoint|continue|extends|onready|preload|return|signal|static|export|setget|assert|remote|master|puppet|while|match|break|class|const|yield|elif|else|pass|self|tool|func|enum|sync|for|var|not|and|if|is|as|in|or)\\b",
      "name": "keyword.control.gdscript"
    },
    "types": {
      "match": "\\b(?:Dictionary|Resource|Vector2|Vector3|Spatial|String|Node2D|float|Color|Array|bool|Node|void|int)\\b",
      "name": "storage.type.gdscript"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.gdscript"
        }
      }
    }
  }
}