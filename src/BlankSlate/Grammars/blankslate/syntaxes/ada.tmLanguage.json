{
  "name": "Ada",
  "scopeName": "source.ada",
  "fileTypes": [
    "adb",
    "ads",
    "ada"
  ],
  "patterns": [
    {
      "include": "#line-comment"
    },
    {
      "include": "#double-string"
    },
    {
      "include": "#single-string"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "line-comment": {
      "match": "(?:\\-\\-).*$",
      "name": "comment.line.ada"
    },
    "double-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.ada",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ada"
        }
      ]
    },
    "single-string": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.ada",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ada"
        }
      ]
    },
    "constants": {
      "match": "(?i)(?<![\\w.])True|False(?![\\w])",
      "name": "constant.language.ada"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.ada"
    },
    "keywords": {
      "match": "(?i)\\b(?:synchronized|overriding|exception|interface|procedure|protected|terminate|abstract|constant|function|separate|aliased|declare|generic|limited|package|private|renames|requeue|reverse|subtype|accept|access|digits|others|pragma|record|return|select|tagged|abort|array|begin|delay|delta|elsif|entry|raise|range|until|while|body|case|else|exit|goto|loop|null|some|task|then|type|when|with|abs|all|and|end|for|mod|new|not|out|rem|use|xor|at|do|if|in|is|of|or)\\b",
      "name": "keyword.control.ada"
    },
    "types": {
      "match": "(?i)\\b(?:Character|Positive|Duration|Integer|Natural|Boolean|String|Float)\\b",
      "name": "storage.type.ada"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.ada"
        }
      }
    }
  }
}