{
  "name": "MATLAB",
  "scopeName": "source.matlab",
  "fileTypes": [
    "m",
    "mlx"
  ],
  "patterns": [
    {
      "include": "#line-comment"
    },
    {
      "include": "#block-comment"
    },
    {
      "include": "#double-string"
    },
    {
      "include": "#single-string"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "line-comment": {
      "match": "(?:%).*$",
      "name": "comment.line.matlab"
    },
    "block-comment": {
      "begin": "%\\{",
      "end": "%\\}",
      "name": "comment.block.matlab"
    },
    "double-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.matlab",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.matlab"
        }
      ]
    },
    "single-string": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.matlab",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.matlab"
        }
      ]
    },
    "constants": {
      "match": "(?<![\\w.])true|false|pi|Inf|NaN|eps|nargin|nargout|varargin|varargout(?![\\w])",
      "name": "constant.language.matlab"
    },
    "numbers": {
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.matlab"
    },
    "keywords": {
      "match": "\\b(?:enumeration|persistent|properties|otherwise|arguments|function|continue|classdef|methods|elseif|switch|return|global|events|parfor|while|break|catch|else|case|spmd|end|for|try|if)\\b",
      "name": "keyword.control.matlab"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.matlab"
        }
      }
    }
  }
}