<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BlankSlate/BlankSlate.csproj" />
    <!-- Build the sample plugin so plugin-loading tests have a real assembly to load,
         but keep it out of the test's own dependency graph (it must load via its own ALC). -->
    <ProjectReference Include="../../samples/TextToolsPlugin/TextToolsPlugin.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
